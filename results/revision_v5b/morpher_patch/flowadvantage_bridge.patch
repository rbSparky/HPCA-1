+static string fa_hash_text(const string &s) {
+	// Stable FNV-1a fingerprint.  This is intentionally deterministic across
+	// processes (unlike an implementation-defined std::hash) and is used only
+	// as an interchange compatibility guard, not for cryptographic security.
+	uint64_t h = 1469598103934665603ULL;
+	for (unsigned char c : s) { h ^= c; h *= 1099511628211ULL; }
+	stringstream ss; ss << hex << h; return ss.str();
+}
+
+static string fa_file_text(const string &file) {
+	ifstream in(file.c_str(), ios::binary); stringstream ss; ss << in.rdbuf(); return ss.str();
+}
+
+static string fa_dfg_signature(DFG *dfg) {
+	stringstream ss;
+	if (!dfg) return "missing";
+	for (DFGNode &n : dfg->nodeList) {
+		ss << n.idx << ":" << n.op << ":" << n.ASAP << ":" << n.ALAP << ":" << n.hasConst << ";";
+		for (DFGNode *p : n.parents) ss << p->idx << ">" << n.idx << ":" << (p->childNextIter.count(&n) ? p->childNextIter[&n] : 0) << ";";
+	}
+	return ss.str();
+}
+
+static void fa_mkdir(const string &d) { mkdir(d.c_str(), 0755); }
+
+static void fa_collect_modules(Module *m, vector<Module*> &out) {
+	out.push_back(m);
+	for (Module *s : m->subModules) fa_collect_modules(s, out);
+}
+
+static void fa_collect_datapaths(Module *m, vector<DataPath*> &out) {
+	if (DataPath *dp = dynamic_cast<DataPath*>(m)) out.push_back(dp);
+	for (Module *s : m->subModules) fa_collect_datapaths(s, out);
+}
+
+static void fa_all_modules(CGRA *cgra, vector<Module*> &out) {
+	vector<Module*> raw;
+	fa_collect_modules(cgra, raw);
+	// Depending on the JSON construction path, time-expanded PEs may be
+	// reachable through the root module and/or the explicit PE list.  Include
+	// both sources and de-duplicate pointers so every native resource (notably
+	// root-level memory wrappers) is represented exactly once.
+	for (PE *pe : cgra->getAllPEList()) fa_collect_modules(pe, raw);
+	set<Module*> seen;
+	for (Module *m : raw) if (seen.insert(m).second) out.push_back(m);
+}
+
+static bool fa_carries(Port *p, DFGNode *node, int destination) {
+	for (auto const &r : p->getMappedNodes())
+		if (std::get<0>(r) == node && std::get<1>(r) == destination) return true;
+	return false;
+}
+
+// Morpher XML inputs in the public corpus can contain duplicate numerical
+// node indices (for example, a loop-control CMERGE and a STOREB).  Native
+// DFG::findNode historically returns the first such node, which is adequate
+// for its original parser but insufficient for an external interchange.  The
+// export already carries the disambiguating native fields; use all of them
+// when reconstructing a placement.
+static string fa_node_key(const DFGNode *node) {
+	if (!node) return "";
+	return to_string(node->idx) + "|" + node->op + "|" +
+		to_string(node->ASAP) + "|" + to_string(node->ALAP) + "|" +
+		node->BB + "|" + (node->hasConst ? "1" : "0") + "|" +
+		to_string(node->constant);
+}
+
+static DFGNode *fa_resolve_node_key(DFG *dfg, const string &key) {
+	DFGNode *found = NULL;
+	for (DFGNode &node : dfg->nodeList) if (fa_node_key(&node) == key) {
+		if (found) return NULL;
+		found = &node;
+	}
+	return found;
+}
+
+static DFGNode *fa_resolve_operation(DFG *dfg, const json &record) {
+	if (record.contains("native_node_key")) {
+		DFGNode *key_match = fa_resolve_node_key(dfg, record.value("native_node_key", ""));
+		if (key_match) return key_match;
+	}
+	int id = record.value("dfg_node_id", -1);
+	vector<DFGNode*> candidates;
+	for (DFGNode &node : dfg->nodeList) if (node.idx == id) candidates.push_back(&node);
+	if (candidates.empty()) return NULL;
+	if (candidates.size() == 1) return candidates[0];
+	string opcode = record.value("opcode", "");
+	int asap = record.value("asap", INT_MIN), alap = record.value("alap", INT_MIN);
+	string bb = record.value("bb", "");
+	int constant = record.value("constant", INT_MIN);
+	vector<DFGNode*> matched;
+	for (DFGNode *node : candidates) {
+		if (!opcode.empty() && node->op != opcode) continue;
+		if (asap != INT_MIN && node->ASAP != asap) continue;
+		if (alap != INT_MIN && node->ALAP != alap) continue;
+		if (!bb.empty() && node->BB != bb) continue;
+		if (constant != INT_MIN && node->constant != constant) continue;
+		matched.push_back(node);
+	}
+	return matched.size() == 1 ? matched[0] : NULL;
+}
+
+static DFGNode *fa_resolve_signal_source(DFG *dfg, int id, int signal_latency) {
+	vector<DFGNode*> candidates;
+	for (DFGNode &node : dfg->nodeList) if (node.idx == id && node.rootDP) candidates.push_back(&node);
+	if (candidates.size() == 1) return candidates[0];
+	// A signal is placed at its producer's output latency and can only advance
+	// from there.  Prefer the latest legal producer output; this distinguishes
+	// duplicate IDs without guessing from coordinates or opcode names.
+	DFGNode *best = NULL; int best_latency = INT_MIN;
+	for (DFGNode *node : candidates) {
+		int output_latency = node->rootDP->getOutputDP()->getOutPort("T")->getLat();
+		if (output_latency <= signal_latency && output_latency > best_latency) {
+			best = node; best_latency = output_latency;
+		}
+	}
+	return best;
+}
+
