+bool CGRAXMLCompile::CGRA::ImportFlowAdvantageMapping(const string &fileName, DFG *dfg, string &error) {
+	ifstream in(fileName); if (!in) { error = "mapping_file_unreadable"; return false; }
+	json m; try { in >> m; } catch (...) { error = "mapping_json_invalid"; return false; }
+	if (m.value("schema", "") != "flowadvantage_morpher_mapping_v1") { error = "schema_mismatch"; return false; }
+	if (m.value("ii", -1) != get_t_max()) { error = "II mismatch"; return false; }
+	if (!dfg) { error = "DFG missing"; return false; }
+	if (m.value("dfg_hash", "") != fa_hash_text(fa_dfg_signature(dfg))) { error = "DFG-hash mismatch"; return false; }
+	if (m.value("architecture_hash", "") != fa_hash_text(fa_file_text(json_file) + ":" + to_string(get_x_max()) + ":" + to_string(get_y_max()) + ":" + to_string(get_t_max()))) { error = "architecture-hash mismatch"; return false; }
+	for (DFGNode &n : dfg->nodeList) if (n.rootDP) n.clear(dfg);
+	for (auto &o : m.value("operations", json::array())) {
+		int id = o.value("dfg_node_id", -1); DFGNode *n = dfg->findNode(id); if (!n) { error = "unknown DFG node"; return false; }
+		string peid = o.value("pe_id", ""); PE *target = NULL; for (PE *pe : getAllPEList()) if (pe->getFullName() == peid) { target = pe; break; }
+		if (!target) { error = "unknown MRRG resource"; return false; }
+		if (target->T != o.value("modulo_time", target->T)) { error = "timing violation"; return false; }
+		bool assigned = false; vector<DataPath*> dps; fa_collect_datapaths(target, dps); for (DataPath *dp : dps) { FU *fu = dp->getFU(); if (fu->supportedOPs.count(n->op) && !dp->getMappedNode()) { dp->assignNode(n, target->T, dfg); assigned = true; break; } }
+		if (!assigned) { error = "unsupported operation or duplicate compute occupancy"; return false; }
+	}
+	for (auto &r : m.value("routes", json::array())) {
+		if (r.value("export_status", "ok") != "ok") { error = "non_contiguous_route"; return false; }
+		auto ids = r.value("ordered_resource_ids", json::array()); if (ids.empty()) { error = "wrong route endpoints"; return false; }
+		int srcid=r.value("source_node",-1), dstid=r.value("destination_node",-1); DFGNode *src=dfg->findNode(srcid); DFGNode *dst=dfg->findNode(dstid); if(!src||!dst) {error="unknown DFG node";return false;}
+		vector<Port*> ports; for (auto &id:ids) { Port *found=NULL; for (PE *pe:getAllPEList()) { vector<Module*> pm; fa_collect_modules(pe,pm); for(Module *mm:pm) { for(auto &kv:mm->getconnectedTo()) if(kv.first->getFullName()==id.get<string>()) found=kv.first; for(auto &kv:mm->getconnectedTo()) for(Port *pp:kv.second) if(pp->getFullName()==id.get<string>()) found=pp; } } if(!found){error="unknown MRRG resource";return false;} ports.push_back(found); }
+		for(size_t i=0;i+1<ports.size();++i) { bool linked=false; for(Port *nxt:ports[i]->getMod()->getNextPorts(ports[i])) if(nxt==ports[i+1]) linked=true; if(!linked){error="non-contiguous route";return false;} }
+		auto lats=r.value("ordered_resource_latencies", json::array());
+		if (lats.size()!=ports.size()) { error="route_latency_missing"; return false; }
+		// This uses the native Port state mutator without a mapper pointer, so it
+		// restores mapping ownership while deliberately not altering PathFinder's
+		// private congestion history.  It is sufficient for native structural
+		// checks and configuration generation on a conflict-free exported route.
+		for(size_t i=0;i<ports.size();++i) ports[i]->setNode(src, lats[i].get<int>(), dstid, NULL);
+		src->routingPorts.push_back(make_pair(ports.back(),dstid));
+	}
+	flowadvantage_imported_mapping_json = m.dump();
+	return true;
+}
