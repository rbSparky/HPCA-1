+	// interchange document reproducible and lets the bridge audit semantic
+	// equality without accepting a serialization-order false negative.
+	sort(mapj["operations"].begin(), mapj["operations"].end(), [](const json &a, const json &b) { return a["dfg_node_id"] < b["dfg_node_id"]; });
+	sort(mapj["port_state"].begin(), mapj["port_state"].end(), [](const json &a, const json &b) { return a["native_port_id"] < b["native_port_id"]; });
+	// Recover ordered native port sequences for every mapped DFG dependency.
+	// The mapper stores signal ownership in Port::mapped_nodes and graph
+	// topology in Module::connectedTo; exporting both preserves native IDs.
+	if (dfg) for (DFGNode &src : dfg->nodeList) for (DFGNode *dstnode : src.children) {
+		// Morpher's PS edges are pseudo predicate/scheduling constraints.  The
+		// native mappers explicitly skip them during route estimation, so they
+		// belong in dfg.json but must not be fabricated as physical MRRG paths.
+		if (src.childrenOPType.count(dstnode) && src.childrenOPType[dstnode] == "PS") continue;
+		if (!src.rootDP || !dstnode->rootDP) continue;
+		Port *start = src.rootDP->getOutputDP()->getOutPort("T");
+		map<Port*, vector<Port*> > adj;
+		for (Module *m : mods) for (auto &kv : m->getconnectedTo()) if (fa_carries(kv.first, &src, dstnode->idx))
+			for (Port *q : kv.second) if (fa_carries(q, &src, dstnode->idx)) adj[kv.first].push_back(q);
+		queue<Port*> q; map<Port*,Port*> prev; q.push(start); prev[start] = NULL; Port *goal = NULL;
+		string destination_pe_id = dstnode->rootDP && dstnode->rootDP->getPE() ? dstnode->rootDP->getPE()->getFullName() : "";
+		size_t destination_pe_suffix = destination_pe_id.rfind(".PE_");
+		if (destination_pe_suffix != string::npos) destination_pe_id = destination_pe_id.substr(0, destination_pe_suffix);
+		// `routingPorts` can contain multiple records for one destination after
+		// fanout routing.  Select the endpoint on the destination PE instead of
+		// accepting the first (which may be a stale source-side terminal).
+		for (auto const &endpoint : src.routingPorts) if (endpoint.second == dstnode->idx) {
+			if (!destination_pe_id.empty() && endpoint.first && endpoint.first->getFullName().find(destination_pe_id) == 0) {
+				goal = endpoint.first;
+				break;
+			}
+		}
+		// A stale routingPorts terminal can point back to the source output for
+		// fanout edges.  Never export that as the destination; fall back to the
+		// reachable terminal belonging to the destination PE.
+		if (goal && !destination_pe_id.empty() && goal->getFullName().find(destination_pe_id) == string::npos) goal = NULL;
+		while (!q.empty() && (!goal || !prev.count(goal))) {
+			Port *p=q.front(); q.pop();
+			if (!goal && !destination_pe_id.empty() && p->getFullName().find(destination_pe_id) != string::npos) { goal=p; break; }
+			for (Port *nxt:adj[p]) if (!prev.count(nxt)) {prev[nxt]=p; q.push(nxt);}
+		}
+		json rr; rr["edge_id"] = fa_node_key(&src) + "->" + fa_node_key(dstnode); rr["source_node"] = src.idx; rr["destination_node"] = dstnode->idx; rr["source_node_key"] = fa_node_key(&src); rr["destination_node_key"] = fa_node_key(dstnode); rr["start_time"] = start->getLat();
+		if (!goal) { rr["export_status"]="route_sequence_unavailable"; mapj["routes"].push_back(rr); continue; }
+		vector<Port*> path; for (Port *p=goal; p; p=prev[p]) path.push_back(p); reverse(path.begin(),path.end());
+		for (size_t k=0;k<path.size();++k) { rr["ordered_resource_ids"].push_back(path[k]->getFullName()); rr["ordered_resource_latencies"].push_back(path[k]->getLat()); if(k+1<path.size()) rr["ordered_link_ids"].push_back(path[k]->getFullName()+"->"+path[k+1]->getFullName()); }
+		rr["end_time"] = goal->getLat(); rr["export_status"]="ok"; mapj["routes"].push_back(rr);
+	}
+	dfgj["metadata"]["native_source"] = "DFG::nodeList"; mrrgj["metadata"]["native_source"] = "CGRA::subModules/getconnectedTo"; mapj["metadata"]["native_source"] = "DataPath::mappedNode + DFGNode::routingPorts";
+	ofstream a(directory + "/dfg.json"), b(directory + "/mrrg.json"), c(directory + "/mapping.json"); if (!a || !b || !c) return false; a << setw(2) << dfgj << endl; b << setw(2) << mrrgj << endl; c << setw(2) << mapj << endl; return true;
+}
