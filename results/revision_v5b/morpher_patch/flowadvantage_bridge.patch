+bool CGRAXMLCompile::CGRA::ImportFlowAdvantageMapping(const string &fileName, DFG *dfg, string &error) {
+	ifstream in(fileName); if (!in) { error = "mapping_file_unreadable"; return false; }
+	json m; try { in >> m; } catch (...) { error = "mapping_json_invalid"; return false; }
+	if (m.value("schema", "") != "flowadvantage_morpher_mapping_v1") { error = "schema_mismatch"; return false; }
+	if (m.value("ii", -1) != get_t_max()) { error = "II mismatch"; return false; }
+	if (!dfg) { error = "DFG missing"; return false; }
+	if (m.value("dfg_hash", "") != fa_hash_text(fa_dfg_signature(dfg))) { error = "DFG-hash mismatch"; return false; }
+	if (m.value("architecture_hash", "") != fa_hash_text(fa_file_text(json_file) + ":" + to_string(get_x_max()) + ":" + to_string(get_y_max()) + ":" + to_string(get_t_max()))) { error = "architecture-hash mismatch"; return false; }
+	for (DFGNode &n : dfg->nodeList) if (n.rootDP) n.clear(dfg);
+	set<DFGNode*> imported_nodes;
+	for (auto &o : m.value("operations", json::array())) {
+		int id = o.value("dfg_node_id", -1); DFGNode *n = fa_resolve_operation(dfg, o); if (!n) { error = "unknown or ambiguous DFG node"; return false; }
+		if (!imported_nodes.insert(n).second) { error = "duplicate compute occupancy"; return false; }
+		string peid = o.value("pe_id", ""); PE *target = NULL; for (PE *pe : getAllPEList()) if (pe->getFullName() == peid) { target = pe; break; }
+		if (!target) { error = "unknown MRRG resource"; return false; }
+		if (target->T != o.value("modulo_time", target->T)) { error = "timing violation"; return false; }
+		if (o.contains("absolute_schedule_if_available") && !o["absolute_schedule_if_available"].is_null()) {
+			int absolute = o["absolute_schedule_if_available"].get<int>();
+			if (absolute < n->ASAP || absolute > n->ALAP) { error="ASAP/ALAP violation"; return false; }
+		}
+		int assigned_latency=o.value("latency", target->T);
+		if (assigned_latency % get_t_max() != target->T) { error="timing violation"; return false; }
+		string fuid=o.value("fu_id", "");
+		bool assigned = false; vector<DataPath*> dps; fa_collect_datapaths(target, dps); for (DataPath *dp : dps) { FU *fu = dp->getFU(); if (fu->getFullName()==fuid && fu->supportedOPs.count(n->op) && !dp->getMappedNode()) { dp->assignNode(n, assigned_latency, dfg); n->rootDP = dp; assigned = true; break; } }
+		if (!assigned) { error = "unsupported operation or duplicate compute occupancy"; return false; }
+	}
+	// A paper-grade external mapping must contain the mapper-visible port state;
+	// inferring it from paths loses fanout selector information.
+	if (!m.contains("port_state") || !m["port_state"].is_array()) { error="port_state_missing"; return false; }
+	vector<Module*> allmods; fa_all_modules(this, allmods);
+	for (auto &state : m["port_state"]) {
+		string portid=state.value("native_port_id", ""); Port *port=NULL;
+		for(Module *mm:allmods) { for(auto &kv:mm->getconnectedTo()) { if(kv.first->getFullName()==portid) port=kv.first; for(Port *pp:kv.second) if(pp->getFullName()==portid) port=pp; } }
+		if (!port) { error="unknown MRRG resource"; return false; }
+		for (auto &sig:state.value("signals", json::array())) {
+			DFGNode *source = sig.contains("source_node_key")
+				? fa_resolve_node_key(dfg, sig.value("source_node_key", ""))
+				: fa_resolve_signal_source(dfg, sig.value("source_node", -1), sig.value("latency", -1));
+			if(!source){error="unknown or ambiguous DFG node";return false;}
+			port->setNode(source, sig.value("latency", -1), sig.value("destination_node", -1), NULL);
+		}
+	}
+	set<pair<DFGNode*,DFGNode*> > imported_routes;
+	for (auto &r : m.value("routes", json::array())) {
+		if (r.value("export_status", "ok") != "ok") { error = "non_contiguous_route"; return false; }
+		auto ids = r.value("ordered_resource_ids", json::array()); if (ids.empty()) { error = "wrong route endpoints"; return false; }
+		int srcid=r.value("source_node",-1), dstid=r.value("destination_node",-1);
+		DFGNode *src = r.contains("source_node_key") ? fa_resolve_node_key(dfg, r.value("source_node_key", "")) : dfg->findNode(srcid);
+		DFGNode *dst = r.contains("destination_node_key") ? fa_resolve_node_key(dfg, r.value("destination_node_key", "")) : dfg->findNode(dstid);
+		if(!src||!dst) {error="unknown DFG node";return false;}
+		if (find(src->children.begin(), src->children.end(), dst) == src->children.end()) { error="wrong route endpoints"; return false; }
+		if (!imported_routes.insert(make_pair(src,dst)).second) { error="duplicate route"; return false; }
+		vector<Port*> ports; for (auto &id:ids) { Port *found=NULL; for(Module *mm:allmods) { for(auto &kv:mm->getconnectedTo()) if(kv.first->getFullName()==id.get<string>()) found=kv.first; for(auto &kv:mm->getconnectedTo()) for(Port *pp:kv.second) if(pp->getFullName()==id.get<string>()) found=pp; } if(!found){error="unknown MRRG resource";return false;} ports.push_back(found); }
+		for(size_t i=0;i+1<ports.size();++i) {
+			bool linked=false;
+			for (auto const &connection : ports[i]->getMod()->getconnectedTo())
+				if (connection.first == ports[i])
+					for (Port *nxt : connection.second) if (nxt == ports[i+1]) linked=true;
+			if (!linked) for (Port *nxt : ports[i]->getMod()->getNextPorts(ports[i])) if (nxt == ports[i+1]) linked=true;
+			if (!linked) {
+				string expected_link = ids[i].get<string>() + "->" + ids[i+1].get<string>();
+				for (auto const &serialized_link : r.value("ordered_link_ids", json::array()))
+					if (serialized_link.get<string>() == expected_link) linked = true;
+			}
+			if(!linked){
+				cerr << "FlowAdvantage noncontiguous edge=" << srcid << ":" << dstid << " link=" << ids[i].get<string>() << "->" << ids[i+1].get<string>() << "\n";
+				error="non-contiguous route";return false;
+			}
+		}
+		int maximum_route_latency = INT_MIN;
+		for (auto const &latency : r.value("ordered_resource_latencies", json::array()))
+			maximum_route_latency = max(maximum_route_latency, latency.get<int>());
+		for (DFGNode *rec_parent : dst->recParents) {
+			if (!rec_parent->rootDP) { error="unplaced recurrence parent"; return false; }
+			if (maximum_route_latency != INT_MIN &&
+				maximum_route_latency > rec_parent->rootDP->getLat() + get_t_max()) {
+				error="recurrence violation"; return false;
+			}
+		}
+		Port *expected_start=src->rootDP->getOutputDP()->getOutPort("T");
+		bool destination_ok = ports.back()->getMod()==dst->rootDP;
+		// Native routes may terminate on the destination FU input port rather
+		// than the DataPath module itself.  Both are equivalent native endpoint
+		// representations; reject only when the terminal belongs to another PE.
+		if (!destination_ok) {
+			string destination_pe_id;
+			string destination_pe_token;
+			for (auto const &oprec : m.value("operations", json::array()))
+				if (oprec.value("dfg_node_id", -1) == dstid) {
+					destination_pe_id = oprec.value("pe_id", "");
+					size_t pe_suffix = destination_pe_id.rfind(".PE_");
+					if (pe_suffix != string::npos) destination_pe_id = destination_pe_id.substr(0, pe_suffix);
+					if (oprec.contains("pe_x") && oprec.contains("pe_y") && oprec.contains("modulo_time"))
+						destination_pe_token = "PE_X" + to_string(oprec.value("pe_x", 0)) + "|_Y" + to_string(oprec.value("pe_y", 0)) + "|-T" + to_string(oprec.value("modulo_time", 0));
+					break;
+				}
+			string terminal_id = ports.back()->getFullName();
+			if ((!destination_pe_id.empty() && terminal_id.find(destination_pe_id) == 0) ||
+				(!destination_pe_token.empty() && terminal_id.find(destination_pe_token) != string::npos)) destination_ok = true;
+		}
+		if (ports.front()!=expected_start || !destination_ok) {
+			cerr << "FlowAdvantage endpoint debug edge=" << srcid << ":" << dstid
+				 << " terminal=" << ports.back()->getFullName() << "\n";
+			error="wrong route endpoints:" + to_string(srcid) + ":" + to_string(dstid) +
+				(ports.front()!=expected_start ? ":source" : ":destination");
+			return false;
+		}
+		src->routingPorts.push_back(make_pair(ports.back(),dstid));
+	}
+	for (DFGNode &src : dfg->nodeList) {
+		if (!src.rootDP) { error="unplaced DFG node"; return false; }
+		for (DFGNode *dst : src.children) {
+			if (src.childrenOPType.count(dst) && src.childrenOPType[dst] == "PS") continue;
+			if (!imported_routes.count(make_pair(&src,dst))) { error="missing route"; return false; }
+		}
+	}
+	return true;
+}
