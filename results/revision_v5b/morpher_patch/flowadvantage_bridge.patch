+bool CGRAXMLCompile::CGRA::ValidateFlowAdvantageMapping(DFG *dfg, string &error) {
+	if (!dfg) { error="DFG missing"; return false; }
+	// Placement completeness and compatibility are established by assignNode;
+	// validate that every native DFG node was in fact assigned.
+	for (DFGNode &n : dfg->nodeList) {
+		if (!n.rootDP) { error="unplaced DFG node "+to_string(n.idx); return false; }
+		FU *fu=n.rootDP->getFU();
+		if (!fu || !fu->supportedOPs.count(n.op)) { error="unsupported operation "+to_string(n.idx); return false; }
+		for (DFGNode *child : n.children) {
+			if (n.childrenOPType.count(child) && n.childrenOPType[child] == "PS") continue;
+			bool routed=false;
+			for (auto &route : n.routingPorts) if (route.second==child->idx) { routed=true; break; }
+			if (!routed) { error="missing route "+to_string(n.idx)+":"+to_string(child->idx); return false; }
+		}
+	}
+	// Morpher permits two signals to share a physical port only when its native
+	// DFG mutex analysis proves that they cannot be live simultaneously.  This
+	// is the same rule used by PathFinder::Port::increaseUse; merely counting
+	// distinct sources incorrectly rejects valid predicated mappings.
+	vector<Module*> mods; fa_all_modules(this, mods);
+	set<Port*> all_ports;
+	for (Module *m : mods) for (auto &kv : m->getconnectedTo()) {
+		all_ports.insert(kv.first);
+		for (Port *p : kv.second) all_ports.insert(p);
+	}
+	auto incompatible_sources = [dfg](Port *resource, Port *left, Port *right) {
+		for (auto const &lhs : left->getMappedNodes()) {
+			DFGNode *lhs_node = std::get<0>(lhs);
+			for (auto const &rhs : right->getMappedNodes()) {
+				DFGNode *rhs_node = std::get<0>(rhs);
+				if (lhs_node == rhs_node) continue;
+				if (!dfg->isMutexNodes(lhs_node, rhs_node, resource)) return true;
+			}
+		}
+		return false;
+	};
+	for (Port *port : all_ports) {
+		if (incompatible_sources(port, port, port)) {
+			error="routing capacity conflict "+port->getFullName();
+			return false;
+		}
+		for (Port *conflict : port->getMod()->getConflictPorts(port)) {
+			if (port >= conflict || !all_ports.count(conflict)) continue;
+			if (incompatible_sources(port, port, conflict)) {
+				error="routing conflict-set violation "+port->getFullName()+" <> "+conflict->getFullName();
+				return false;
+			}
+		}
+	}
+	error.clear(); return true;
+}
