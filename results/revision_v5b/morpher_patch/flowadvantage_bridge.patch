+bool CGRAXMLCompile::CGRA::ExportFlowAdvantageState(const string &directory, DFG *dfg) {
+	fa_mkdir(directory);
+	json dfgj, mrrgj, mapj;
+	dfgj["schema"] = "flowadvantage_morpher_dfg_v1";
+	dfgj["ii"] = get_t_max();
+	dfgj["dfg_hash"] = fa_hash_text(fa_dfg_signature(dfg));
+	if (dfg) {
+		for (DFGNode &n : dfg->nodeList) {
+			json x; x["dfg_node_id"] = n.idx; x["opcode"] = n.op; x["latency"] = n.rootDP ? n.rootDP->getLat() : 0;
+			x["asap"] = n.ASAP; x["alap"] = n.ALAP; x["has_constant"] = n.hasConst; x["constant"] = n.constant; x["bb"] = n.BB;
+			for (DFGNode *p : n.parents) { json e; e["source_node"] = p->idx; e["destination_node"] = n.idx; e["iteration_distance"] = p->childNextIter.count(&n) ? p->childNextIter[&n] : 0; e["edge_type"] = "data"; e["source_latency"] = p->rootDP ? p->rootDP->getLat() : 0; e["required_time_difference"] = n.ASAP-p->ASAP; dfgj["dependencies"].push_back(e); }
+			dfgj["nodes"].push_back(x);
+		}
+	}
+	mrrgj["schema"] = "flowadvantage_morpher_mrrg_v1"; mrrgj["ii"] = get_t_max();
+	mrrgj["architecture_hash"] = fa_hash_text(fa_file_text(json_file) + ":" + to_string(get_x_max()) + ":" + to_string(get_y_max()) + ":" + to_string(get_t_max()));
+	mapj["schema"] = "flowadvantage_morpher_mapping_v1"; mapj["toolchain_commit"] = "9a9dce7aea521f1d5ef33686f57ca84864edb3c9"; mapj["ii"] = get_t_max(); mapj["architecture_hash"] = mrrgj["architecture_hash"]; mapj["dfg_hash"] = dfgj["dfg_hash"]; mapj["dependencies"] = dfgj["dependencies"]; mapj["resources"] = mrrgj["resources"]; mapj["memory_bindings"] = json::array(); mapj["metadata"] = json::object();
+	bool reexport_imported = !flowadvantage_imported_mapping_json.empty();
+	if (reexport_imported) {
+		try { mapj = json::parse(flowadvantage_imported_mapping_json); }
+		catch (...) { return false; }
+	}
+	vector<Module*> mods; mods.push_back(this);
+	for (PE *pe : getAllPEList()) fa_collect_modules(pe, mods);
+	for (Module *m : mods) {
+		json r; r["native_resource_id"] = m->getFullName(); r["resource_type"] = m->get_type(); r["time_slot"] = m->get_t(); r["capacity"] = 1;
+		if (PE *pe = dynamic_cast<PE*>(m)) { r["x"] = pe->X; r["y"] = pe->Y; }
+		if (FU *fu = dynamic_cast<FU*>(m)) { for (auto &op : fu->supportedOPs) r["supported_operations"].push_back(op.first); r["memory_role"] = fu->isMEMFU() ? "memory" : "compute"; }
+		mrrgj["resources"].push_back(r);
+		for (auto &kv : m->getconnectedTo()) {
+			json sr; sr["native_resource_id"] = kv.first->getFullName(); sr["resource_type"] = "port"; sr["port_type"] = (int)kv.first->getType(); sr["time_slot"] = kv.first->getMod()->get_t();
+			if (PE *pe = kv.first->findParentPE()) { sr["x"] = pe->X; sr["y"] = pe->Y; }
+			mrrgj["resources"].push_back(sr);
+			for (Port *dst : kv.second) { json e; e["src"] = kv.first->getFullName(); e["dst"] = dst->getFullName(); e["capacity"] = 1; mrrgj["edges"].push_back(e); }
+		}
+	}
+	if (!reexport_imported) mapj["resources"] = mrrgj["resources"];
+	for (Module *sm : mods) if (!reexport_imported) if (DataPath *dp = dynamic_cast<DataPath*>(sm)) {
+		if (!dp->getMappedNode()) continue;
+		PE *pe = dp->getPE(); FU *fu = dp->getFU(); DFGNode *n = dp->getMappedNode(); json o; o["dfg_node_id"] = n->idx; o["opcode"] = n->op; o["capabilities"] = json::array(); o["pe_id"] = pe->getFullName(); o["pe_x"] = pe->X; o["pe_y"] = pe->Y; o["fu_id"] = fu->getFullName(); o["modulo_time"] = pe->T; o["absolute_schedule_if_available"] = nullptr; o["latency"] = dp->getLat(); o["asap"] = n->ASAP; o["alap"] = n->ALAP; o["fixed_or_flexible"] = "native_fixed"; mapj["operations"].push_back(o);
+	}
+	// Recover ordered native port sequences for every mapped DFG dependency.
+	// The mapper stores signal ownership in Port::mapped_nodes and graph
+	// topology in Module::connectedTo; exporting both preserves native IDs.
+	if (!reexport_imported && dfg) for (DFGNode &src : dfg->nodeList) for (DFGNode *dstnode : src.children) {
+		if (!src.rootDP || !dstnode->rootDP) continue;
+		Port *start = src.rootDP->getOutputDP()->getOutPort("T");
+		map<Port*, vector<Port*> > adj;
+		for (Module *m : mods) for (auto &kv : m->getconnectedTo()) if (fa_carries(kv.first, &src, dstnode->idx))
+			for (Port *q : kv.second) if (fa_carries(q, &src, dstnode->idx)) adj[kv.first].push_back(q);
+		queue<Port*> q; map<Port*,Port*> prev; q.push(start); prev[start] = NULL; Port *goal = NULL;
+		while (!q.empty() && !goal) { Port *p=q.front(); q.pop(); if (p->getMod()==dstnode->rootDP) { goal=p; break; } for (Port *nxt:adj[p]) if (!prev.count(nxt)) {prev[nxt]=p; q.push(nxt);} }
+		json rr; rr["edge_id"] = to_string(src.idx) + ":" + to_string(dstnode->idx); rr["source_node"] = src.idx; rr["destination_node"] = dstnode->idx; rr["start_time"] = start->getLat();
+		if (!goal) { rr["export_status"]="route_sequence_unavailable"; mapj["routes"].push_back(rr); continue; }
+		vector<Port*> path; for (Port *p=goal; p; p=prev[p]) path.push_back(p); reverse(path.begin(),path.end());
+		for (size_t k=0;k<path.size();++k) { rr["ordered_resource_ids"].push_back(path[k]->getFullName()); rr["ordered_resource_latencies"].push_back(path[k]->getLat()); if(k+1<path.size()) rr["ordered_link_ids"].push_back(path[k]->getFullName()+"->"+path[k+1]->getFullName()); }
+		rr["end_time"] = goal->getLat(); rr["export_status"]="ok"; mapj["routes"].push_back(rr);
+	}
+	dfgj["metadata"]["native_source"] = "DFG::nodeList"; mrrgj["metadata"]["native_source"] = "CGRA::subModules/getconnectedTo"; mapj["metadata"]["native_source"] = "DataPath::mappedNode + DFGNode::routingPorts";
+	ofstream a(directory + "/dfg.json"), b(directory + "/mrrg.json"), c(directory + "/mapping.json"); if (!a || !b || !c) return false; a << setw(2) << dfgj << endl; b << setw(2) << mrrgj << endl; c << setw(2) << mapj << endl; return true;
+}
